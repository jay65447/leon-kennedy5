.glow{position:fixed;z-index:-2;border-radius:50%;filter:blur(120px);pointer-events:none}
.g1{width:480px;height:480px;background:var(--red);opacity:.22;top:-150px;left:-120px}
.g2{width:420px;height:420px;background:var(--steel);opacity:.14;bottom:-160px;right:-120px}
header{position:sticky;top:0;z-index:50;padding:12px 0;backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);background:rgba(10,10,12,.7);border-bottom:1px solid var(--line)}
.nav{display:flex;align-items:center;justify-content:space-between}
.logo{font-weight:800;font-size:1.3rem;letter-spacing:.5px}.logo b{color:var(--red)}
nav ul{display:flex;gap:4px;list-style:none;margin:0;padding:0}
nav a{padding:8px 16px;border-radius:99px;color:var(--mut);font-weight:500;transition:.3s}
nav a:hover,nav a.on{color:var(--ink);background:var(--glass)}
.menu{display:none;background:var(--glass);border:1px solid var(--line);color:var(--ink);width:44px;height:44px;border-radius:12px;font-size:1.3rem;cursor:pointer}
.hero{padding:80px 0 60px;display:grid;grid-template-columns:1.2fr .8fr;gap:36px;align-items:center;min-height:78vh}
.tag{display:inline-block;padding:6px 16px;border-radius:99px;background:var(--glass);border:1px solid var(--line);color:var(--amb);font-size:.9rem;margin-bottom:18px}
h1{font-size:clamp(2.2rem,5.4vw,4rem);line-height:1.25;margin:0 0 18px;font-weight:800}
.grad{background:linear-gradient(120deg,var(--red),var(--amb));-webkit-background-clip:text;background-clip:text;color:transparent}
