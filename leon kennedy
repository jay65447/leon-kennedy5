.head p{color:var(--mut);margin:0}
.facts{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.fact,.acc{background:var(--glass);border:1px solid var(--line);border-radius:20px;backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}
.fact{padding:22px;text-align:center;transition:transform .3s,border-color .3s}
.fact:hover{transform:translateY(-6px);border-color:var(--red)}
.fact span{display:block;color:var(--mut);font-size:.9rem}.fact b{font-size:1.15rem;color:var(--amb)}
.list{display:grid;gap:14px;max-width:820px;margin-inline:auto}
details.acc{overflow:hidden;transition:border-color .3s,box-shadow .3s}
details.acc:hover,details.acc[open]{border-color:rgba(209,34,45,.6)}
details.acc[open]{box-shadow:0 18px 44px -24px rgba(209,34,45,.7)}
summary{list-style:none;cursor:pointer;padding:20px 24px;display:flex;align-items:center;justify-content:space-between;gap:14px;font-weight:700;font-size:1.15rem}
summary::-webkit-details-marker{display:none}
summary small{display:block;color:var(--amb);font-weight:500;font-size:.85rem}
summary::after{content:"+";flex:none;width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:var(--glass);border:1px solid var(--line);font-size:1.3rem;transition:transform .35s,background .35s}
details[open] summary::after{transform:rotate(135deg);background:var(--red)}
.body{padding:0 24px 22px;color:var(--mut);animation:op .45s ease}
@keyframes op{from{opacity:0;transform:translateY(-8px)}}
.note{max-width:820px;margin:30px auto 0;text-align:center;color:var(--mut);font-size:.9rem}
footer{border-top:1px solid var(--line);padding:40px 0 34px;text-align:center;background:rgba(0,0,0,.4)}
.copy{font-weight:700;margin:0 0 6px}.sub{color:var(--mut);font-size:.85rem;margin:0 0 22px}
.pic{width:170px;height:170px;margin:0 auto;border-radius:24px;border:2px dashed var(--line);display:grid;place-items:center;color:var(--mut);font-size:.85rem;padding:14px;background:var(--glass)}
.pic img{width:100%;height:100%;object-fit:cover;border-radius:20px}
.rv{opacity:0;transform:translateY(28px);transition:opacity .8s ease,transform .8s ease}.rv.in{opacity:1;transform:none}
:focus-visible{outline:2px solid var(--amb);outline-offset:3px}
@media(max-width:860px){.hero{grid-template-columns:1fr;text-align:center;padding-top:40px;min-height:0}.lead{margin-inline:auto}.facts{grid-template-columns:repeat(2,1fr)}.menu{display:block}
nav{position:absolute;top:100%;right:0;left:0;background:rgba(10,10,12,.97);padding:10px 4%;display:none;border-bottom:1px solid var(--line)}nav.open{display:block}nav ul{flex-direction:column}}
.badgecol{max-width:340px;margin-inline:auto;width:100%}
