.leon:hover{transform:translateY(-6px)}
.leon img{display:block;width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:21px}
.leon figcaption{position:absolute;inset:auto 3px 3px 3px;padding:34px 16px 12px;border-radius:0 0 21px 21px;background:linear-gradient(transparent,rgba(0,0,0,.85));text-align:center;font-weight:800;letter-spacing:3px;font-size:.85rem;color:var(--ink)}
