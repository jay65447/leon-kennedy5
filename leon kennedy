<style>
:root{--bg:#0a0a0c;--ink:#f1ece6;--mut:#a39c94;--red:#d1222d;--amb:#e8a33d;--steel:#6f8aa3;--glass:rgba(255,255,255,.05);--line:rgba(255,255,255,.12);color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:80px}
body{margin:0;background:var(--bg);color:var(--ink);font-family:'Tajawal','Segoe UI',Tahoma,sans-serif;line-height:1.85;overflow-x:hidden}
